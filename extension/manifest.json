{
    "manifest_version": 3,
    "name": "OwnPulse CRM",
    "version": "1.0",
    "description": "Minimalist CRM Extension for LinkedIn, Threads, and Instagram",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://*.linkedin.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*",
        "https://*.instagram.com/*",
        "https://*.supabase.co/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.linkedin.com/in/*",
                "https://*.threads.net/@*",
                "https://*.threads.com/@*",
                "https://*.instagram.com/*/"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ]
}