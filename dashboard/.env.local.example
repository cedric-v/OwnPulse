# OwnPulse dashboard — environment variables (copy to .env.local and fill in)
# Get these values from: Supabase dashboard > Project Settings > API
#
# IMPORTANT: these are the PUBLISHABLE keys. Never put the `service_role`
# (secret) key in .env.local, the browser bundle, or the extension.

# e.g. https://<project-ref>.supabase.co  (no trailing slash)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable anon key (sb_publishable_... or legacy anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
